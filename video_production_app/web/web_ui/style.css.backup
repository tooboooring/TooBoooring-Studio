/* --- 1. Variables & Theme --- */
:root {
  /* Colors - Dark Theme Palette */
  --bg-app: #0f172a; /* Deep blue-black */
  --bg-panel: #1e293b; /* Slate 800 */
  --bg-panel-header: #334155; /* Slate 700 */
  --bg-input: #0f172a;

  --text-primary: #f1f5f9; /* Slate 100 */
  --text-secondary: #94a3b8; /* Slate 400 */
  --text-muted: #64748b; /* Slate 500 */

  --primary-color: #3b82f6; /* Blue 500 */
  --primary-hover: #2563eb; /* Blue 600 */
  --secondary-color: #475569; /* Slate 600 */
  --secondary-hover: #334155; /* Slate 700 */
  --accent-color: #8b5cf6; /* Violet 500 */
  --accent-hover: #7c3aed; /* Violet 600 */

  --border-color: #334155;
  --border-focus: #3b82f6;

  /* Spacing */
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 12px;
  --spacing-lg: 16px;

  /* Borders */
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);

  /* Transitions */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* --- 2. Global Reset --- */
* {
  box-sizing: border-box;
}

body,
html {
  margin: 0;
  padding: 0;
  width: 100vw;
  height: 100vh;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    sans-serif;
  background-color: var(--bg-app);
  color: var(--text-primary);
  overflow: hidden;
  font-size: 13px;
  line-height: 1.5;
}

/* Scrollbar Styling */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-app);
}

::-webkit-scrollbar-thumb {
  background: var(--secondary-color);
  border-radius: 4px;
}

/* --- 1. Variables & Theme --- */
:root {
  /* Colors - Dark Theme Palette */
  --bg-app: #0f172a; /* Deep blue-black */
  --bg-panel: #1e293b; /* Slate 800 */
  --bg-panel-header: #334155; /* Slate 700 */
  --bg-input: #0f172a;

  --text-primary: #f1f5f9; /* Slate 100 */
  --text-secondary: #94a3b8; /* Slate 400 */
  --text-muted: #64748b; /* Slate 500 */

  --primary-color: #3b82f6; /* Blue 500 */
  --primary-hover: #2563eb; /* Blue 600 */
  --secondary-color: #475569; /* Slate 600 */
  --secondary-hover: #334155; /* Slate 700 */
  --accent-color: #8b5cf6; /* Violet 500 */
  --accent-hover: #7c3aed; /* Violet 600 */

  --border-color: #334155;
  --border-focus: #3b82f6;

  /* Spacing */
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 12px;
  --spacing-lg: 16px;

  /* Borders */
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1),
    0 4px 6px -4px rgb(0 0 0 / 0.1);

  /* Transitions */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* --- 2. Global Reset --- */
* {
  box-sizing: border-box;
}

body,
html {
  margin: 0;
  padding: 0;
  width: 100vw;
  height: 100vh;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    sans-serif;
  background-color: var(--bg-app);
  color: var(--text-primary);
  overflow: hidden;
  font-size: 13px;
  line-height: 1.5;
}

/* Scrollbar Styling */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-app);
}

::-webkit-scrollbar-thumb {
  background: var(--secondary-color);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}

/* --- 3. App Layout --- */
.app-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
}

/* --- 4. Toolbar --- */
.toolbar {
    flex: 0 0 56px; /* Fixed height */
    background-color: var(--bg-panel);
    border-bottom: 1px solid var(--border-color);
    padding: var(--spacing-sm) var(--spacing-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    z-index: 10;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.divider-vertical {
    width: 1px;
    height: 24px;
    background-color: var(--border-color);
    margin: 0 var(--spacing-xs);
}

.status-label {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
}

/* --- 5. Main Content Area (Split Pane) --- */
.main-content {
    flex: 1; /* Takes remaining height */
    display: flex;
    flex-direction: row; /* Horizontal split */
    min-height: 0;
    overflow: hidden;
    background-color: var(--bg-app);
    padding: 0; /* Remove padding to let panels touch splitters */
}

/* --- Splitters --- */
.splitter-vertical {
    width: 8px;
    background-color: var(--bg-app);
    cursor: col-resize;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
    z-index: 5;
}

.splitter-vertical::after {
    content: '';
    width: 2px;
    height: 24px;
    background-color: var(--border-color);
    border-radius: 1px;
}

.splitter-vertical:hover, .splitter-vertical.dragging {
    background-color: var(--primary-color);
}

.splitter-vertical:hover::after, .splitter-vertical.dragging::after {
    background-color: white;
}

.splitter-horizontal {
    height: 8px;
    background-color: var(--bg-app);
    cursor: row-resize;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
    z-index: 5;
}

.splitter-horizontal::after {
    content: '';
    height: 2px;
    width: 24px;
    background-color: var(--border-color);
    border-radius: 1px;
}

.splitter-horizontal:hover, .splitter-horizontal.dragging {
    background-color: var(--primary-color);
}

.splitter-horizontal:hover::after, .splitter-horizontal.dragging::after {
    background-color: white;
}

/* --- 6. Panels --- */
.panel {
    background-color: var(--bg-panel);
    /* border: 1px solid var(--border-color); Removed border for cleaner split look */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* box-shadow: var(--shadow-md); Removed shadow for flat look */
}

.panel-header {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--bg-panel-header);
    border-bottom: 1px solid var(--border-color);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: 0 0 auto; /* Fixed header height */
    user-select: none;
}

.panel-header i {
    margin-right: 6px;
    color: var(--primary-color);
}

.panel-content {
    flex: 1;
    overflow: hidden;
    position: relative;
}

.scrollable-content {
    overflow-y: auto;
    padding: var(--spacing-lg);
}

/* --- 7. Player Panel --- */
.player-panel {
    flex: 1; /* Default flex grow */
    min-width: 200px;
    background-color: #000;
}

.player-content {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.video-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
    position: relative;
    overflow: hidden;
}

#video-player {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
}

.player-controls-bar {
    background-color: var(--bg-panel);
    border-top: 1px solid var(--border-color);
    padding: var(--spacing-sm) var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    height: 48px;
    flex: 0 0 auto;
}

.playback-controls {
    display: flex;
    gap: var(--spacing-xs);
}

.audio-tracks-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
}

.time-display {
    margin-left: auto;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    color: var(--text-primary);
    font-size: 12px;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
}

/* --- 8. Controls Panel --- */
.controls-panel {
    width: 350px; /* Initial width */
    min-width: 250px;
    border-left: 1px solid var(--border-color);
}

.control-section {
    margin-bottom: var(--spacing-lg);
}

.section-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--spacing-sm);
    letter-spacing: 0.05em;
}

.divider-horizontal {
    height: 1px;
    background-color: var(--border-color);
    margin: var(--spacing-lg) 0;
}

/* --- 9. Components --- */

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: 13px;
    cursor: pointer;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
    gap: 8px;
    white-space: nowrap;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.btn-primary {
    background-color: var(--primary-color);
    color: white;
    box-shadow: 0 1px 2px rgba(59, 130, 246, 0.3);
}

.btn-primary:hover {
    background-color: var(--primary-hover);
    transform: translateY(-1px);
}

.btn-secondary {
    background-color: var(--bg-panel-header);
    color: var(--text-primary);
    border-color: var(--border-color);
}

.btn-secondary:hover {
    background-color: var(--secondary-color);
    border-color: var(--text-secondary);
}

.btn-accent {
    background-color: var(--accent-color);
    color: white;
}

.btn-accent:hover {
    background-color: var(--accent-hover);
    transform: translateY(-1px);
}

.btn-outline {
    background-color: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
}

.btn-outline:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.05);
}

.btn-icon {
    padding: 6px;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    border: none;
    cursor: pointer;
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
}

.btn-icon:hover {
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.1);
}

.btn-icon-small {
    padding: 4px;
    width: 24px;
    height: 24px;
    font-size: 12px;
}

.btn-sm {
    padding: 4px 10px;
    font-size: 12px;
}

.btn-lg {
    padding: 10px 20px;
    font-size: 14px;
}

.btn-block {
    width: 100%;
    display: flex;
}

/* Inputs & Selects */
.form-group {
    margin-bottom: var(--spacing-md);
}

.form-group label {
    display: block;
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 4px;
}

.form-input, select {
    width: 100%;
    padding: 8px 10px;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 13px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-input:focus, select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
}

.select-wrapper {
    position: relative;
}

.select-wrapper::after {
    content: '\f078'; /* FontAwesome chevron-down */
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
    font-size: 10px;
}

select {
    appearance: none;
    padding-right: 30px;
    cursor: pointer;
}

/* Checkbox */
.checkbox-group {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

.custom-checkbox {
    appearance: none;
    width: 16px;
    height: 16px;
    border: 1px solid var(--border-color);
    border-radius: 3px;
    background-color: var(--bg-input);
    cursor: pointer;
    position: relative;
}

.custom-checkbox:checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.custom-checkbox:checked::after {
    content: '\f00c';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    font-size: 10px;
    color: white;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

/* Text Areas */
.code-area, .console-area {
    width: 100%;
    height: 120px;
    background-color: #000;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 8px;
    color: #10b981; /* Terminal green */
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
    resize: vertical;
    line-height: 1.4;
}

.code-area {
    color: var(--text-secondary);
}

/* Progress Bar */
.progress-container {
    height: 8px;
    background-color: var(--bg-input);
    border-radius: 4px;
    overflow: hidden;
    margin: 8px 0;
}

.progress-fill {
    height: 100%;
    background-color: var(--primary-color);
    width: 0%;
    transition: width 0.3s ease;
    border-radius: 4px;
}

.progress-text {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-color);
}

/* Helper Text */
.helper-text {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
}

/* Layout Helpers */
.row {
    display: flex;
    gap: var(--spacing-md);
}

.col {
    flex: 1;
}

.gap-sm {
    gap: var(--spacing-sm);
}

.mb-2 {
    margin-bottom: var(--spacing-sm);
}

.input-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
}

.file-path-label {
    font-size: 11px;
    color: var(--text-muted);
    word-break: break-all;
    padding: 4px;
    background: rgba(0,0,0,0.2);
    border-radius: var(--radius-sm);
}

/* --- 10. Timeline Panel --- */
.timeline {
    height: 280px; /* Initial height */
    min-height: 150px;
    border-top: 1px solid var(--border-color);
    background-color: var(--bg-panel);
    flex: 0 0 auto; /* Fixed height, resizable via JS */
}

.timeline-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.btn-group {
    display: flex;
    align-items: center;
    background-color: var(--bg-input);
    border-radius: var(--radius-sm);
    padding: 2px;
    border: 1px solid var(--border-color);
}

.zoom-label {
    font-size: 11px;
    color: var(--text-secondary);
    min-width: 40px;
    text-align: center;
}

.timeline-content {
    padding: 0;
    display: flex;
    flex-direction: column;
    background-color: #111;
    position: relative;
    flex: 1;
}

.timeline-canvas {
    display: block;
    width: 100%;
}

.ruler {
    height: 30px;
    background-color: #1a1a1a;
    border-bottom: 1px solid #333;
}

.waveform {
    flex: 1; /* Fill remaining space */
    background-color: #111;
    /* Add subtle grid pattern for professional look */
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100% 50px;
}

.segments {
    height: 40px;
    background-color: #0d0d0d;
    border-top: 1px solid #333;
}

.divider-vertical-small {
    width: 1px;
    height: 16px;
    background-color: var(--border-color);
}

/* Audio Track Buttons */
.audio-track-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s;
}

.audio-track-button:hover {
    border-color: var(--primary-color);
    color: var(--text-primary);
}

.audio-track-button.muted {
    opacity: 0.5;
    text-decoration: line-through;
}

/* AI Status Box */
.status-box {
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-top: var(--spacing-sm);
}

#ai-analysis-summary {
    color: #34d399;
    font-size: 11px;
}
